# Fastify API origin. Every request includes the httpOnly session cookie.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Explicitly opt into deterministic browser-local world/contribution data.
# This bypasses the server and is visibly labelled Sandbox. When false, API
# failures are shown and never replaced with synthetic world data.
NEXT_PUBLIC_SANDBOX_MODE=false

# Show account creation only when the connected API itself runs in SANDBOX_MODE.
# Keep false in production; regular production registration needs a real
# email/OAuth provider and is intentionally not impersonated by this switch.
NEXT_PUBLIC_ALLOW_SANDBOX_REGISTRATION=true
