{
  "expo": {
    "name": "إعلاني",
    "slug": "e3lani",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "e3lani",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#FFC400",
    "backgroundColor": "#FFFFFF",
    "splash": {
      "backgroundColor": "#FFC400",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sa.e3lani.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "نحتاج الوصول إلى الصور لرفع صور ومقاطع إعلانك.",
        "NSCameraUsageDescription": "نحتاج الكاميرا لتصوير إعلانك مباشرة.",
        "NSLocationWhenInUseUsageDescription": "نستخدم موقعك لعرض الإعلانات القريبة منك فقط.",
        "CFBundleAllowMixedLocalizations": true
      },
      "splash": {
        "backgroundColor": "#FFC400"
      },
      "icon": "./assets/icon.png",
      "associatedDomains": [
        "applinks:e3lani.sa",
        "applinks:www.e3lani.sa"
      ]
    },
    "android": {
      "package": "sa.e3lani.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFC400",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "splash": {
        "backgroundColor": "#FFC400"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "e3lani.sa",
              "pathPrefix": "/ad"
            },
            {
              "scheme": "https",
              "host": "e3lani.sa",
              "pathPrefix": "/u"
            },
            {
              "scheme": "https",
              "host": "www.e3lani.sa",
              "pathPrefix": "/ad"
            },
            {
              "scheme": "https",
              "host": "www.e3lani.sa",
              "pathPrefix": "/u"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول إلى الصور لرفع وسائط إعلانك."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نستخدم موقعك لعرض الإعلانات القريبة منك."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FFC400",
          "resizeMode": "contain",
          "imageWidth": 180
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFC400"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://localhost:4000/api",
      "siteUrl": "http://localhost:3000"
    },
    "icon": "./assets/icon.png",
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#FFC400"
    }
  }
}
