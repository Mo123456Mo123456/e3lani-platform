{
  "expo": {
    "name": "إعلاني",
    "slug": "e3lani",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "e3lani",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "sa.e3lani.app"
    },
    "android": {
      "package": "sa.e3lani.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFC400"
      }
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
