# Android signing — never commit real keystores or passwords
#
# Create a local (gitignored) file, e.g. `apps/mobile/android/keystore.properties`,
# OR export environment variables before `./gradlew assembleRelease` /
# `scripts/build-staging-release-apk.sh`.
#
# Required for release/staging distribution signing:
# E3LANI_KEYSTORE_FILE=/absolute/path/to/e3lani-staging.keystore
# E3LANI_KEYSTORE_PASSWORD=...
# E3LANI_KEY_ALIAS=...
# E3LANI_KEY_PASSWORD=...
#
# Optional: copy these lines into a gitignored gradle.properties fragment
# and load via: `cp keystore.properties.example keystore.properties` then
# export $(grep -v '^#' keystore.properties | xargs)
#
# Generate a new staging keystore (example):
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore ~/secrets/e3lani-staging.keystore \
#     -alias e3lani-staging -keyalg RSA -keysize 2048 -validity 10000
#
# Production Play Store uploads should use a separate production keystore
# never shared with staging.
E3LANI_KEYSTORE_FILE=
E3LANI_KEYSTORE_PASSWORD=
E3LANI_KEY_ALIAS=
E3LANI_KEY_PASSWORD=
