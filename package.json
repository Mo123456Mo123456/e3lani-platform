{
  "name": "living-planet-platform",
  "version": "0.1.0",
  "private": true,
  "description": "كوكب يولد أمامك — deterministic living-world simulation platform",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "predev": "pnpm --filter @living-planet/api... --filter @living-planet/realtime-gateway... build",
    "dev": "pnpm --parallel --filter @living-planet/api --filter @living-planet/realtime-gateway --filter @living-planet/web --filter @living-planet/admin dev",
    "build": "pnpm -r --if-present build",
    "precheck": "pnpm --filter @living-planet/simulation-engine... build && pnpm --filter @living-planet/validation... build",
    "check": "pnpm -r --if-present check",
    "pretest": "pnpm --filter @living-planet/simulation-engine... build && pnpm --filter @living-planet/validation... build",
    "test": "pnpm -r --if-present test",
    "test:simulation": "pnpm --filter @living-planet/simulation-engine test",
    "db:migrate": "pnpm --filter @living-planet/api db:migrate",
    "db:seed": "pnpm --filter @living-planet/api db:seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "latest",
    "typescript": "latest"
  }
}
