{
  "name": "planet-born",
  "version": "0.1.0",
  "private": true,
  "description": "كوكب يولد أمامك — Living procedural planet simulation platform",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @planet/api --filter @planet/web --filter @planet/realtime-gateway dev",
    "dev:web": "pnpm --filter @planet/web dev",
    "dev:api": "pnpm --filter @planet/api dev",
    "dev:admin": "pnpm --filter @planet/admin dev",
    "dev:realtime": "pnpm --filter @planet/realtime-gateway dev",
    "dev:sim": "cd services/simulation-engine && .venv/bin/uvicorn app.main:app --reload --port 8001",
    "dev:ai": "cd services/ai-orchestrator && .venv/bin/uvicorn app.main:app --reload --port 8002",
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' --filter './services/api' --filter './services/realtime-gateway' --filter './services/notification-worker' build",
    "test": "pnpm -r test && pnpm test:sim && pnpm test:ai",
    "test:unit": "pnpm -r --filter './packages/*' --filter './services/api' test",
    "test:sim": "cd services/simulation-engine && .venv/bin/pytest -q",
    "test:ai": "cd services/ai-orchestrator && .venv/bin/pytest -q",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @planet/db generate",
    "db:migrate": "pnpm --filter @planet/db migrate",
    "db:seed": "pnpm --filter @planet/db seed",
    "db:studio": "pnpm --filter @planet/db studio",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "setup": "pnpm install && pnpm setup:python && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "setup:python": "bash scripts/setup-python.sh",
    "check": "pnpm -r --filter './packages/*' --filter './apps/*' --filter './services/api' typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}
