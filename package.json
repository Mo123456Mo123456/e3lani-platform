{
  "name": "e3lani-platform",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"{apps,services,packages}/**/*.{ts,tsx,js,json,md,css}\"",
    "db:generate": "pnpm --filter @e3lani/database generate",
    "db:migrate": "pnpm --filter @e3lani/database migrate",
    "db:seed": "pnpm --filter @e3lani/database seed",
    "dev:infra": "docker compose up -d postgres redis minio minio-init",
    "archive": "node scripts/create-archive.mjs"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.5.6",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.19.0"
  }
}
