{
  "name": "e3lani-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,yml,yaml,prisma}\"",
    "db:generate": "pnpm --filter @e3lani/database generate",
    "db:migrate": "pnpm --filter @e3lani/database migrate",
    "db:seed": "pnpm --filter @e3lani/database seed",
    "infra:up": "docker compose up -d postgres redis minio minio-init",
    "infra:down": "docker compose down",
    "zip": "node scripts/create-archive.mjs"
  },
  "devDependencies": {
    "@e3lani/eslint-config": "workspace:*",
    "eslint": "^9.39.5",
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "~5.9.3"
  }
}
