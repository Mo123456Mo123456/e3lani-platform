{
  "name": "e3lani-platform",
  "version": "0.1.0",
  "private": true,
  "description": "إعلاني | E3lani — The Visual Advertising Platform for Everything",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @e3lani/api prisma:generate",
    "db:migrate": "pnpm --filter @e3lani/api prisma:migrate",
    "db:seed": "pnpm --filter @e3lani/api prisma:seed",
    "test:integration": "node scripts/phase2-integration.mjs",
    "media-worker": "pnpm --filter @e3lani/media-worker start"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "@nestjs/testing": "^10.4.15",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2",
    "sharp": "^0.33.5",
    "ioredis": "^5.4.2"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@types/react": "18.3.18",
      "@types/react-dom": "18.3.5"
    }
  }
}
