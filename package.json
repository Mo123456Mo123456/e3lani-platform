{
  "name": "planet-born",
  "version": "0.1.0",
  "private": true,
  "description": "كوكب يولد أمامك — Living procedural planet simulation platform",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @planet-born/web dev",
    "dev:admin": "pnpm --filter @planet-born/admin dev",
    "dev:api": "pnpm --filter @planet-born/api dev",
    "dev:sim": "pnpm --filter @planet-born/simulation-engine dev",
    "dev:ai": "pnpm --filter @planet-born/ai-orchestrator dev",
    "dev:realtime": "pnpm --filter @planet-born/realtime-gateway dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @planet-born/api db:generate",
    "db:migrate": "pnpm --filter @planet-born/api db:migrate",
    "db:seed": "pnpm --filter @planet-born/api db:seed",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "~5.9.3"
  }
}
