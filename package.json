{
  "name": "planet-born",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --sort run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --sort run test",
    "dev:api": "pnpm --filter @planet/api run dev",
    "dev:web": "pnpm --filter @planet/web run dev",
    "dev:admin": "pnpm --filter @planet/admin run dev",
    "db:migrate": "pnpm --filter @planet/api run db:migrate",
    "db:seed": "pnpm --filter @planet/api run db:seed"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.6.3"
  }
}
