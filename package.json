{
  "name": "planet-born-before-you",
  "version": "0.1.0",
  "private": true,
  "description": "كوكب يولد أمامك — deterministic living-world platform",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @planet/web --filter @planet/api dev",
    "dev:web": "pnpm --filter @planet/web dev",
    "dev:api": "pnpm --filter @planet/api dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "db:migrate": "pnpm --filter @planet/api db:migrate",
    "db:seed": "pnpm --filter @planet/api db:seed",
    "format": "prettier --write \"{apps,services,packages}/**/*.{ts,tsx,css,json,md}\"",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "vite": "^8.2.0",
    "vitest": "latest"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@isaacs/brace-expansion": "5.0.1",
      "ajv": "8.20.0",
      "fast-uri": "3.1.4",
      "minimatch": "10.2.6",
      "postcss": "8.5.25",
      "sharp": "0.35.3",
      "yaml": "2.9.0"
    }
  }
}
