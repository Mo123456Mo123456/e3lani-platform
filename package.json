{
  "name": "kawkab-planetborn",
  "version": "0.1.0",
  "private": true,
  "description": "كوكب يولد أمامك — Planetborn. A living, deterministic, simulated 3D planet where every user adds one element and watches its causal impact unfold across millennia.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:web": "pnpm --filter @kawkab/web dev",
    "dev:admin": "pnpm --filter @kawkab/admin dev",
    "dev:api": "pnpm --filter @kawkab/api start:dev",
    "dev:ai": "pnpm --filter @kawkab/ai-orchestrator dev",
    "dev:sim": "pnpm --filter @kawkab/simulation-engine dev",
    "db:generate": "pnpm --filter @kawkab/api prisma:generate",
    "db:migrate:dev": "pnpm --filter @kawkab/api prisma:migrate",
    "db:deploy": "pnpm --filter @kawkab/api prisma:deploy",
    "db:seed": "pnpm --filter @kawkab/api seed"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "~5.5.4"
  }
}
