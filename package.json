{
  "name": "e3lani-platform",
  "version": "1.0.0",
  "private": true,
  "description": "إعلاني | منصة الإعلانات المرئية لكل شيء",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"{apps,services,packages}/**/*.{ts,tsx,js,json,css,md}\"",
    "db:generate": "pnpm --filter @e3lani/database generate",
    "db:migrate": "pnpm --filter @e3lani/database migrate",
    "db:seed": "pnpm --filter @e3lani/database seed",
    "infra:up": "docker compose up -d postgres redis minio createbuckets",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0"
}
