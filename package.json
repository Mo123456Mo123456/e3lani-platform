{
  "name": "planet-born-before-you",
  "version": "0.1.0",
  "private": true,
  "description": "كوكب يولد أمامك — deterministic living-world simulation platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @planet/web dev",
    "dev:api": "pnpm --filter @planet/api dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"{apps,services,packages,docs}/**/*.{ts,tsx,js,json,md,css,py,yml,yaml}\"",
    "db:migrate": "pnpm --filter @planet/database migrate",
    "db:seed": "pnpm --filter @planet/database seed"
  },
  "devDependencies": {
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "latest",
    "vite": "^8.2.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  }
}
