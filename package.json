{
  "name": "planet-genesis",
  "version": "0.1.0",
  "private": true,
  "description": "كوكب يولد أمامك — A living procedural planet where every user contribution cascades through a deterministic causal simulation.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test:python": "pytest services/ai-orchestrator services/simulation-engine",
    "seed": "pnpm --filter @planet/api run seed",
    "clean": "pnpm -r exec rm -rf dist node_modules .next"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.12.0"
}
