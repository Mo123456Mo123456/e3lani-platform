{
  "name": "planet-born",
  "version": "0.1.0",
  "private": true,
  "description": "كوكب يولد أمامك — A Planet Born Before You",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @planet/api --filter @planet/web --filter @planet/admin run dev",
    "dev:api": "pnpm --filter @planet/api dev",
    "dev:web": "pnpm --filter @planet/web dev",
    "dev:admin": "pnpm --filter @planet/admin dev",
    "dev:sim": "cd services/simulation-engine && ../../.venv/bin/uvicorn app.main:app --reload --port 8001",
    "dev:ai": "cd services/ai-orchestrator && ../../.venv/bin/uvicorn app.main:app --reload --port 8002",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @planet/api build && pnpm --filter @planet/web build && pnpm --filter @planet/admin build",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @planet/simulation-core test && pnpm --filter @planet/api test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @planet/api db:migrate",
    "db:seed": "pnpm --filter @planet/api db:seed",
    "db:reset": "pnpm --filter @planet/api db:reset",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "setup": "pnpm install && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt && pnpm db:migrate && pnpm db:seed"
  },
  "engines": {
    "node": ">=20"
  }
}
