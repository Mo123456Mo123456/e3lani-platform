{
  "name": "planet-born-before-you",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @kawkab/api db:migrate",
    "db:seed": "pnpm --filter @kawkab/api db:seed",
    "docker:up": "docker compose up --build"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "turbo": "latest",
    "typescript": "6.0.3",
    "vitest": "latest"
  },
  "pnpm": {
    "overrides": {
      "typescript": "6.0.3"
    }
  }
}
