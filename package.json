{
  "name": "living-planet-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:web": "pnpm --filter @living-planet/web dev",
    "dev:api": "pnpm --filter @living-planet/api dev",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"{apps,services,packages}/**/*.{ts,tsx,css,json,md}\"",
    "db:migrate": "pnpm --filter @living-planet/api db:migrate",
    "db:seed": "pnpm --filter @living-planet/api db:seed"
  },
  "devDependencies": {
    "@types/node": "latest",
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "latest"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.25",
      "qs": "6.15.3",
      "sharp": "0.35.3"
    }
  }
}
