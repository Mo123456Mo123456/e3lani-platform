{
  "name": "planet-born",
  "version": "0.1.0",
  "private": true,
  "description": "كوكب يولد أمامك — Planet Born Before You",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @planet/api --filter @planet/web --filter @planet/ai-orchestrator --filter @planet/simulation-engine dev",
    "dev:web": "pnpm --filter @planet/web dev",
    "dev:api": "pnpm --filter @planet/api dev",
    "dev:sim": "pnpm --filter @planet/simulation-engine dev",
    "dev:ai": "pnpm --filter @planet/ai-orchestrator dev",
    "dev:admin": "pnpm --filter @planet/admin dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @planet/api build && pnpm --filter @planet/web build && pnpm --filter @planet/admin build",
    "test": "pnpm -r --filter './packages/*' --filter './services/*' test",
    "lint": "pnpm -r lint --if-present",
    "typecheck": "pnpm -r typecheck --if-present",
    "db:migrate": "pnpm --filter @planet/api db:migrate",
    "db:seed": "pnpm --filter @planet/api db:seed",
    "db:reset": "pnpm --filter @planet/api db:reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  }
}
