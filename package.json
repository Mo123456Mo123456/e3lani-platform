{
  "name": "e3lani-platform",
  "version": "1.0.0",
  "private": true,
  "description": "إعلاني | منصة الإعلانات المرئية لكل شيء",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"{apps,services,packages}/**/*.{ts,tsx,js,json,css,md}\"",
    "db:generate": "pnpm --filter @e3lani/database generate",
    "db:migrate": "pnpm --filter @e3lani/database migrate",
    "db:seed": "pnpm --filter @e3lani/database seed",
    "infra:up": "docker compose up -d postgres redis minio createbuckets",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
