{
  "name": "e3lani",
  "version": "1.0.0",
  "private": true,
  "description": "إعلاني | E3lani — منصة الإعلانات المرئية لكل شيء",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "db:generate": "pnpm --filter @e3lani/database generate",
    "db:migrate": "pnpm --filter @e3lani/database migrate:dev",
    "db:deploy": "pnpm --filter @e3lani/database migrate:deploy",
    "db:seed": "pnpm --filter @e3lani/database seed",
    "db:studio": "pnpm --filter @e3lani/database studio",
    "dev:api": "pnpm --filter @e3lani/api dev",
    "dev:worker": "pnpm --filter @e3lani/media-worker dev",
    "dev:web": "pnpm --filter @e3lani/web dev",
    "dev:admin": "pnpm --filter @e3lani/admin dev",
    "dev:mobile": "pnpm --filter @e3lani/mobile start"
  },
  "devDependencies": {
    "@e3lani/eslint-config": "workspace:*",
    "@e3lani/tsconfig": "workspace:*",
    "prettier": "^3.4.2",
    "turbo": "^2.10.7",
    "typescript": "5.7.3"
  }
}
