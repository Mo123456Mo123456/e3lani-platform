NODE_ENV=development
APP_ENV=development
DATABASE_URL=postgresql://e3lani:e3lani@localhost:5432/e3lani?schema=public
REDIS_URL=redis://localhost:6379
# Media / object storage — R2 for production worker; sandbox possible locally
STORAGE_PROVIDER=r2
R2_ENDPOINT=http://127.0.0.1:9000
R2_BUCKET=e3lani
R2_ACCESS_KEY_ID=e3lani
R2_SECRET_ACCESS_KEY=e3lanisecret
# STORAGE_PROVIDER=sandbox
# SANDBOX_STORAGE_ENABLED=true

# API uses "inline" for sandbox/staging without a worker; use "queue" when this worker is deployed.
# MEDIA_PROCESSING_MODE=queue
