{
  "name": "@e3lani/media-worker",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@e3lani/config": "workspace:*",
    "@e3lani/database": "workspace:*",
    "@e3lani/types": "workspace:*",
    "bullmq": "^5.34.6",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.4.2",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@e3lani/eslint-config": "workspace:*",
    "@e3lani/tsconfig": "workspace:*",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "5.7.3",
    "vitest": "^2.1.8"
  }
