{
  "name": "@living-planet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@living-planet/shared-types": "workspace:*",
    "@living-planet/simulation-models": "workspace:*",
    "@nats-io/transport-node": "^3.4.0",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "jose": "latest",
    "postgres": "latest",
    "swagger-ui-express": "latest",
    "ws": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/swagger-ui-express": "latest",
    "@types/ws": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "^6.0.3",
    "vitest": "latest"
  }
}
