{
  "name": "@planet/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/db/migrations dist/db/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "node --watch -r ts-node/register/transpile-only src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "@planet/api-client": "workspace:*",
    "@planet/config": "workspace:*",
    "@planet/shared-types": "workspace:*",
    "@planet/validation": "workspace:*",
    "bcryptjs": "^2.4.3",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
