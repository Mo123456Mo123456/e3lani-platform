{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "E3lani React Native (Expo)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true
  }
}
