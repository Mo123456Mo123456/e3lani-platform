{
  "name": "@e3lani/database",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "push": "dotenv -e ../../.env -- prisma db push",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo",
    "validate": "dotenv -e ../../.env -- prisma validate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@e3lani/config": "workspace:*",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@e3lani/tsconfig": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "prisma": "6.19.3",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2",
    "typescript": "5.7.3",
    "dotenv-cli": "^8.0.0"
  }
}
