generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  INDIVIDUAL
  STORE
  BRAND
  COMPANY
}

enum StaffRole {
  USER
  SUPER_ADMIN
  ADS_MODERATOR
  SUPPORT
  CAMPAIGN_MANAGER
  FINANCE_MANAGER
  CONTENT_MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaStatus {
  PENDING_UPLOAD
  UPLOADED
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum AdStatus {
  DRAFT
  AWAITING_PAYMENT
  ACTIVE
  PAUSED
  SUSPENDED
  EXPIRED
  DELETED
}

enum AudienceScope {
  CITY
  NATIONWIDE
}

enum ContactType {
  STORE
  PRODUCT
  WHATSAPP
  PHONE
  EXTERNAL
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum AppealStatus {
  OPEN
  ACCEPTED
  REJECTED
}

enum BannerStatus {
  DRAFT
  AWAITING_PAYMENT
  AWAITING_REVIEW
  APPROVED
  ACTIVE
  REJECTED
  EXPIRED
  PAUSED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum AnalyticsSource {
  ORGANIC
  PAID
}

model User {
  id                   String                 @id @default(uuid()) @db.Uuid
  phone                String                 @unique @db.VarChar(20)
  name                 String?                @db.VarChar(100)
  email                String?                @unique @db.VarChar(254)
  accountType          AccountType            @default(INDIVIDUAL)
  staffRole            StaffRole              @default(USER)
  status               UserStatus             @default(ACTIVE)
  avatarUrl            String?
  preferredLanguage    String                 @default("ar") @db.VarChar(5)
  termsAcceptedAt      DateTime?
  privacyAcceptedAt    DateTime?
  cityId               String?                @db.Uuid
  city                 City?                  @relation(fields: [cityId], references: [id])
  businessProfile      BusinessProfile?
  sessions             AuthSession[]
  otpChallenges        OtpChallenge[]
  media                MediaAsset[]
  ads                  Ad[]
  posts                ProfilePost[]
  favoriteAds          FavoriteAd[]
  savedPosts           SavedPost[]
  reports              Report[]               @relation("Reporter")
  moderatedReports     Report[]               @relation("ReportModerator")
  appeals              Appeal[]               @relation("Appellant")
  reviewedAppeals      Appeal[]               @relation("AppealReviewer")
  notifications        Notification[]
  analyticsEvents      AnalyticsEvent[]
  orders               Order[]
  banners              BannerPlacement[]
  auditLogs            AuditLog[]             @relation("AuditActor")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([cityId])
  @@index([staffRole, status])
}

model BusinessProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug         String   @unique @db.VarChar(100)
  logoUrl      String?
  coverUrl     String?
  bio          String?  @db.VarChar(1000)
  websiteUrl   String?
  whatsapp     String?  @db.VarChar(20)
  instagramUrl String?
  xUrl         String?
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  deviceName       String?   @db.VarChar(120)
  ipAddress        String?   @db.VarChar(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())

  @@index([userId, revokedAt])
}

model OtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @db.Uuid
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String    @db.VarChar(20)
  codeHash    String
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone, createdAt])
}

model Region {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(80)
  nameAr    String   @db.VarChar(100)
  nameEn    String   @db.VarChar(100)
  cities    City[]
  createdAt DateTime @default(now())
}

model City {
  id        String   @id @default(uuid()) @db.Uuid
  regionId  String   @db.Uuid
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  slug      String   @unique @db.VarChar(80)
  nameAr    String   @db.VarChar(100)
  nameEn    String   @db.VarChar(100)
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  active    Boolean  @default(true)
  users     User[]
  ads       Ad[]
  createdAt DateTime @default(now())

  @@index([regionId, active])
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  parentId    String?    @db.Uuid
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  slug        String     @unique @db.VarChar(100)
  nameAr      String     @db.VarChar(100)
  nameEn      String     @db.VarChar(100)
  icon        String?    @db.VarChar(80)
  sortOrder   Int        @default(0)
  active      Boolean    @default(true)
  categoryAds Ad[]       @relation("PrimaryCategory")
  subcategoryAds Ad[]    @relation("Subcategory")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId, active, sortOrder])
}

model MediaAsset {
  id             String      @id @default(uuid()) @db.Uuid
  ownerId        String      @db.Uuid
  owner          User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind           MediaKind
  status         MediaStatus @default(PENDING_UPLOAD)
  originalKey    String      @unique
  mimeType       String      @db.VarChar(80)
  bytes          Int
  width          Int?
  height         Int?
  durationMs     Int?
  thumbnailUrl   String?
  variants       Json?
  failureReason  String?
  adMedia        AdMedia[]
  postMedia      PostMedia[]
  bannerLogos    BannerPlacement[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([ownerId, status])
}

model Ad {
  id              String          @id @default(uuid()) @db.Uuid
  ownerId         String          @db.Uuid
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title           String          @db.VarChar(120)
  description     String?         @db.VarChar(4000)
  categoryId      String          @db.Uuid
  category        Category        @relation("PrimaryCategory", fields: [categoryId], references: [id])
  subcategoryId   String          @db.Uuid
  subcategory     Category        @relation("Subcategory", fields: [subcategoryId], references: [id])
  cityId          String?         @db.Uuid
  city            City?           @relation(fields: [cityId], references: [id])
  audienceScope   AudienceScope
  status          AdStatus        @default(DRAFT)
  featuredUntil   DateTime?
  sponsoredUntil  DateTime?
  topUntil        DateTime?
  publishedAt     DateTime?
  expiresAt       DateTime?
  suspendedAt     DateTime?
  suspensionReason String?
  media           AdMedia[]
  contacts        AdContact[]
  favorites       FavoriteAd[]
  reports         Report[]
  appeals         Appeal[]
  analytics       AnalyticsEvent[]
  metrics         AdMetricDaily[]
  orders          Order[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status])
  @@index([cityId, status])
  @@index([ownerId, status])
}

model AdMedia {
  id           String     @id @default(uuid()) @db.Uuid
  adId         String     @db.Uuid
  ad           Ad         @relation(fields: [adId], references: [id], onDelete: Cascade)
  mediaAssetId String     @db.Uuid
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  sortOrder    Int        @default(0)

  @@unique([adId, mediaAssetId])
  @@unique([adId, sortOrder])
}

model AdContact {
  id        String      @id @default(uuid()) @db.Uuid
  adId      String      @db.Uuid
  ad        Ad          @relation(fields: [adId], references: [id], onDelete: Cascade)
  type      ContactType
  value     String      @db.VarChar(500)
  label     String?     @db.VarChar(80)
  sortOrder Int         @default(0)
}

model ProfilePost {
  id        String      @id @default(uuid()) @db.Uuid
  ownerId   String      @db.Uuid
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  caption   String?     @db.VarChar(2200)
  media     PostMedia[]
  saves     SavedPost[]
  published Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([ownerId, published, createdAt(sort: Desc)])
}

model PostMedia {
  id           String      @id @default(uuid()) @db.Uuid
  postId       String      @db.Uuid
  post         ProfilePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAssetId String      @db.Uuid
  mediaAsset   MediaAsset  @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  sortOrder    Int         @default(0)

  @@unique([postId, mediaAssetId])
  @@unique([postId, sortOrder])
}

model FavoriteAd {
  userId    String   @db.Uuid
  adId      String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, adId])
}

model SavedPost {
  userId    String      @db.Uuid
  postId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      ProfilePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([userId, postId])
}

model Report {
  id            String       @id @default(uuid()) @db.Uuid
  adId          String       @db.Uuid
  ad            Ad           @relation(fields: [adId], references: [id], onDelete: Cascade)
  reporterId    String       @db.Uuid
  reporter      User         @relation("Reporter", fields: [reporterId], references: [id])
  reason        String       @db.VarChar(60)
  details       String?      @db.VarChar(1000)
  status        ReportStatus @default(OPEN)
  moderatorId   String?      @db.Uuid
  moderator     User?        @relation("ReportModerator", fields: [moderatorId], references: [id])
  resolution    String?      @db.VarChar(1000)
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([adId, status])
}

model Appeal {
  id          String       @id @default(uuid()) @db.Uuid
  adId        String       @db.Uuid
  ad          Ad           @relation(fields: [adId], references: [id], onDelete: Cascade)
  appellantId String       @db.Uuid
  appellant   User         @relation("Appellant", fields: [appellantId], references: [id])
  message     String       @db.VarChar(2000)
  status      AppealStatus @default(OPEN)
  reviewerId  String?      @db.Uuid
  reviewer    User?        @relation("AppealReviewer", fields: [reviewerId], references: [id])
  decision    String?      @db.VarChar(1000)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(80)
  titleAr   String    @db.VarChar(180)
  titleEn   String    @db.VarChar(180)
  bodyAr    String    @db.VarChar(1000)
  bodyEn    String    @db.VarChar(1000)
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt(sort: Desc)])
}

model AnalyticsEvent {
  id              String          @id @default(uuid()) @db.Uuid
  adId            String          @db.Uuid
  ad              Ad              @relation(fields: [adId], references: [id], onDelete: Cascade)
  userId          String?         @db.Uuid
  user            User?           @relation(fields: [userId], references: [id])
  event           String          @db.VarChar(50)
  watchDurationMs Int?
  cityId          String?         @db.Uuid
  source          AnalyticsSource @default(ORGANIC)
  dedupeKey       String?         @unique @db.VarChar(180)
  occurredAt      DateTime        @default(now())

  @@index([adId, event, occurredAt])
}

model AdMetricDaily {
  id                String   @id @default(uuid()) @db.Uuid
  adId              String   @db.Uuid
  ad                Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  date              DateTime @db.Date
  impressions       Int      @default(0)
  uniqueReach       Int      @default(0)
  videoViews        Int      @default(0)
  videoCompletions  Int      @default(0)
  watchDurationMs   BigInt   @default(0)
  contactClicks     Int      @default(0)
  saves             Int      @default(0)
  shares            Int      @default(0)

  @@unique([adId, date])
}

model PricingItem {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique @db.VarChar(60)
  nameAr       String   @db.VarChar(120)
  nameEn       String   @db.VarChar(120)
  priceHalalas Int
  durationDays Int?
  enabled      Boolean  @default(true)
  version      Int      @default(1)
  updatedById  String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  user           User          @relation(fields: [userId], references: [id])
  adId           String?       @db.Uuid
  ad             Ad?           @relation(fields: [adId], references: [id])
  status         PaymentStatus @default(PENDING)
  totalHalalas   Int
  currency       String        @default("SAR") @db.Char(3)
  idempotencyKey String        @unique @db.VarChar(120)
  provider       String        @db.VarChar(40)
  providerRef    String?       @unique @db.VarChar(180)
  items          Json
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, createdAt(sort: Desc)])
}

model BannerPlacement {
  id          String       @id @default(uuid()) @db.Uuid
  ownerId     String       @db.Uuid
  owner       User         @relation(fields: [ownerId], references: [id])
  logoMediaId String       @db.Uuid
  logoMedia   MediaAsset   @relation(fields: [logoMediaId], references: [id])
  status      BannerStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  reviewNote  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, startsAt, endsAt])
}

model AppSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(80)
  entityId   String?  @db.VarChar(100)
  reason     String?  @db.VarChar(1000)
  before     Json?
  after      Json?
  ipAddress  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}
