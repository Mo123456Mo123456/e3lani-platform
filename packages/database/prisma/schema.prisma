// ============================================================================
//  إعلاني | E3lani — مخطط قاعدة البيانات
//  ملاحظة مهمة: المنشورات المجانية (Post) منفصلة تمامًا عن الإعلانات (Ad)
//  في الجداول والعلاقات والاستعلامات، ولا تظهر أبدًا في موجز الإعلانات.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// التعدادات
// ---------------------------------------------------------------------------

enum AccountType {
  INDIVIDUAL
  STORE
  BRAND
  COMPANY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AdStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  PAUSED
  EXPIRED
  REJECTED
  REMOVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum MediaPurpose {
  AD
  POST
  AVATAR
  LOGO
  COVER
  TICKER_LOGO
}

enum ContactMethod {
  WHATSAPP
  PHONE
  STORE_LINK
  PRODUCT_LINK
  EXTERNAL_LINK
}

enum ReachScope {
  CITY
  KINGDOM
}

enum PromotionType {
  REPUBLISH
  EXTEND_15
  HIGHLIGHT_3
  HIGHLIGHT_7
  TOP_OF_CATEGORY
  EXTRA_CITY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  ACTIONED
  DISMISSED
}

enum AppealStatus {
  OPEN
  ACCEPTED
  REJECTED
}

enum TickerStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_REVIEW
  APPROVED
  ACTIVE
  REJECTED
  EXPIRED
  STOPPED
}

enum AdminRole {
  SUPER_ADMIN
  ADS_MODERATOR
  SUPPORT
  CAMPAIGN_MANAGER
  FINANCE_MANAGER
  CONTENT_MANAGER
}

enum AdEventType {
  IMPRESSION
  VIEW_START
  VIEW_COMPLETE
  CLICK_WHATSAPP
  CLICK_CALL
  CLICK_STORE
  CLICK_LINK
  SAVE
  UNSAVE
  SHARE
  REPORT
}

enum ImpressionSource {
  ORGANIC
  PROMOTED
}

enum OtpPurpose {
  LOGIN
  REGISTER
  PHONE_CHANGE
}

enum ConsentType {
  TERMS
  PRIVACY
  MARKETING
}

enum DataRequestType {
  EXPORT
  DELETE
}

enum DataRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PaymentAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
}

// ---------------------------------------------------------------------------
// الحسابات والمصادقة
// ---------------------------------------------------------------------------

model User {
  id               String      @id @default(cuid())
  phone            String      @unique
  name             String?
  email            String?     @unique
  accountType      AccountType @default(INDIVIDUAL)
  status           UserStatus  @default(ACTIVE)
  locale           String      @default("ar")
  cityId           String?
  avatarMediaId    String?     @unique
  isVerified       Boolean     @default(false)
  profileCompleted Boolean     @default(false)
  termsAcceptedAt  DateTime?
  privacyAcceptedAt DateTime?
  suspendedReason  String?
  suspendedAt      DateTime?
  lastSeenAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  city             City?           @relation(fields: [cityId], references: [id], onDelete: SetNull)
  avatarMedia      MediaAsset?     @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  business         BusinessProfile?
  ads              Ad[]
  posts            Post[]
  savedAds         SavedAd[]
  savedPosts       SavedPost[]
  sessions         Session[]
  ownedMedia       MediaAsset[]    @relation("MediaOwner")
  reportsFiled     Report[]        @relation("ReportReporter")
  appeals          Appeal[]
  notifications    Notification[]
  payments         Payment[]
  tickerRequests   TickerRequest[]
  pushTokens       PushToken[]
  events           AdEvent[]
  consents         ConsentRecord[]
  dataRequests     UserDataRequest[]
  affinities       UserCategoryAffinity[]
  adRevisions      AdRevision[]      @relation("AdRevisionUser")

  @@index([cityId])
  @@index([accountType, status])
  @@index([createdAt])
  @@map("users")
}

model BusinessProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  displayName   String?
  bio           String?
  logoMediaId   String?   @unique
  coverMediaId  String?   @unique
  storeUrl      String?
  websiteUrl    String?
  whatsapp      String?
  contactPhone  String?
  socials       Json?
  verifiedAt    DateTime?
  verifiedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logoMedia   MediaAsset? @relation("BusinessLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  coverMedia  MediaAsset? @relation("BusinessCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  @@map("business_profiles")
}

model OtpChallenge {
  id          String     @id @default(cuid())
  phone       String
  codeHash    String
  purpose     OtpPurpose @default(LOGIN)
  attempts    Int        @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  ip          String?
  createdAt   DateTime   @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  deviceId         String?
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs        AuditLog[]
  resolvedReports  Report[]          @relation("ReportResolver")
  decidedAppeals   Appeal[]          @relation("AppealDecider")
  reviewedTickers  TickerRequest[]   @relation("TickerReviewer")
  pricingVersions  PricingVersion[]  @relation("PricingAuthor")
  adRevisions      AdRevision[]      @relation("AdRevisionAdmin")
  handledRequests  UserDataRequest[] @relation("DataRequestHandler")
  requestedRefunds Refund[]          @relation("RefundRequester")

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// الكتالوج: المناطق والمدن والأقسام
// ---------------------------------------------------------------------------

model Region {
  id      String @id @default(cuid())
  slug    String @unique
  nameAr  String
  nameEn  String
  cities  City[]

  @@map("regions")
}

model City {
  id        String  @id @default(cuid())
  slug      String  @unique
  nameAr    String
  nameEn    String
  regionId  String
  lat       Float
  lng       Float
  isPopular Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  region   Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  users    User[]
  ads      Ad[]
  adCities AdCity[]
  events   AdEvent[]

  @@index([regionId])
  @@index([isActive])
  @@map("cities")
}

model Category {
  id        String  @id @default(cuid())
  slug      String  @unique
  nameAr    String
  nameEn    String
  icon      String?
  parentId  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[] @relation("CategoryTree")
  ads           Ad[]       @relation("AdCategory")
  adsAsSubcategory Ad[]    @relation("AdSubcategory")
  affinities    UserCategoryAffinity[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// الوسائط
// ---------------------------------------------------------------------------

model MediaAsset {
  id           String       @id @default(cuid())
  ownerId      String
  type         MediaType
  status       MediaStatus  @default(PENDING)
  purpose      MediaPurpose @default(AD)
  originalKey  String
  playbackKey  String?
  thumbnailKey String?
  variants     Json?
  mimeType     String
  sizeBytes    Int          @default(0)
  width        Int?
  height       Int?
  durationMs   Int?
  blurhash     String?
  checksum     String?
  error        String?
  processedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  owner            User             @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  userAvatar       User?            @relation("UserAvatar")
  businessLogo     BusinessProfile? @relation("BusinessLogo")
  businessCover    BusinessProfile? @relation("BusinessCover")
  adMedia          AdMedia[]
  postMedia        PostMedia[]
  tickerRequests   TickerRequest[]

  @@index([ownerId, createdAt])
  @@index([status])
  @@map("media_assets")
}

// ---------------------------------------------------------------------------
// الإعلانات
// ---------------------------------------------------------------------------

model Ad {
  id              String        @id @default(cuid())
  userId          String
  title           String
  description     String?
  categoryId      String
  subcategoryId   String?
  cityId          String
  reachScope      ReachScope    @default(CITY)
  price           Decimal?      @db.Decimal(12, 2)
  currency        String        @default("SAR")
  status          AdStatus      @default(DRAFT)
  contactMethod   ContactMethod
  contactValue    String

  publishedAt        DateTime?
  expiresAt          DateTime?
  lastBumpedAt       DateTime?
  highlightUntil     DateTime?
  topOfCategoryUntil DateTime?

  viewsCount       Int @default(0)
  impressionsCount Int @default(0)
  savesCount       Int @default(0)
  sharesCount      Int @default(0)
  clicksCount      Int @default(0)
  reportsCount     Int @default(0)

  rejectionReason String?
  moderationNote  String?
  suspendedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category   @relation("AdCategory", fields: [categoryId], references: [id])
  subcategory Category?  @relation("AdSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  city        City       @relation(fields: [cityId], references: [id])

  media       AdMedia[]
  revisions   AdRevision[]
  extraCities AdCity[]
  savedBy     SavedAd[]
  reports     Report[]
  appeals     Appeal[]
  promotions  Promotion[]
  payments    Payment[]
  events      AdEvent[]
  dailyStats  AdDailyStat[]
  score       AdScore?

  @@index([status, publishedAt])
  @@index([status, lastBumpedAt])
  @@index([categoryId, status])
  @@index([cityId, status])
  @@index([userId, status])
  @@index([expiresAt])
  @@index([topOfCategoryUntil])
  @@map("ads")
}

/// لقطة لكل تعديل على الإعلان — تاريخ كامل قابل للمراجعة.
model AdRevision {
  id            String   @id @default(cuid())
  adId          String
  editorUserId  String?
  editorAdminId String?
  reason        String?
  changedFields String[]
  before        Json
  after         Json
  createdAt     DateTime @default(now())

  ad          Ad         @relation(fields: [adId], references: [id], onDelete: Cascade)
  editorUser  User?      @relation("AdRevisionUser", fields: [editorUserId], references: [id], onDelete: SetNull)
  editorAdmin AdminUser? @relation("AdRevisionAdmin", fields: [editorAdminId], references: [id], onDelete: SetNull)

  @@index([adId, createdAt])
  @@map("ad_revisions")
}

model AdMedia {
  adId    String
  mediaId String
  order   Int    @default(0)

  ad    Ad         @relation(fields: [adId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([adId, mediaId])
  @@index([mediaId])
  @@map("ad_media")
}

model AdCity {
  adId   String
  cityId String

  ad   Ad   @relation(fields: [adId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([adId, cityId])
  @@index([cityId])
  @@map("ad_cities")
}

model SavedAd {
  userId    String
  adId      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ad   Ad   @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@id([userId, adId])
  @@index([userId, createdAt])
  @@map("saved_ads")
}

// ---------------------------------------------------------------------------
// المنشورات المجانية — كيان مستقل تمامًا عن الإعلانات
// ---------------------------------------------------------------------------

model Post {
  id         String    @id @default(cuid())
  userId     String
  caption    String
  isActive   Boolean   @default(true)
  removedAt  DateTime?
  removalReason String?
  viewsCount Int       @default(0)
  savesCount Int       @default(0)
  sharesCount Int      @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  media   PostMedia[]
  savedBy SavedPost[]
  reports Report[]
  appeals Appeal[]

  @@index([userId, createdAt])
  @@index([isActive])
  @@map("posts")
}

model PostMedia {
  postId  String
  mediaId String
  order   Int    @default(0)

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, mediaId])
  @@index([mediaId])
  @@map("post_media")
}

model SavedPost {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt])
  @@map("saved_posts")
}

// ---------------------------------------------------------------------------
// البلاغات والاعتراضات
// ---------------------------------------------------------------------------

model Report {
  id           String       @id @default(cuid())
  adId         String?
  postId       String?
  reporterId   String?
  reason       String
  note         String?
  status       ReportStatus @default(OPEN)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  ad         Ad?        @relation(fields: [adId], references: [id], onDelete: Cascade)
  post       Post?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter   User?      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy AdminUser? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  appeals    Appeal[]

  @@index([status, createdAt])
  @@index([adId])
  @@index([postId])
  @@map("reports")
}

model Appeal {
  id           String       @id @default(cuid())
  userId       String
  adId         String?
  postId       String?
  reportId     String?
  message      String
  status       AppealStatus @default(OPEN)
  decisionNote String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime     @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ad        Ad?        @relation(fields: [adId], references: [id], onDelete: Cascade)
  post      Post?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  report    Report?    @relation(fields: [reportId], references: [id], onDelete: SetNull)
  decidedBy AdminUser? @relation("AppealDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@map("appeals")
}

// ---------------------------------------------------------------------------
// الأسعار والمدفوعات والترويج
// ---------------------------------------------------------------------------

/// تعريف الخدمة القابلة للتسعير. السعر نفسه يعيش في PricingVersion.
model PricingItem {
  id            String   @id @default(cuid())
  key           String   @unique
  nameAr        String
  nameEn        String
  descriptionAr String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  versions PricingVersion[]

  @@map("pricing_items")
}

/// إصدار سعر: سجل يُضاف إليه ولا يُعدَّل.
/// السعر النافذ = الإصدار الذي يقع «الآن» داخل نطاق سريانه.
model PricingVersion {
  id            String    @id @default(cuid())
  itemId        String
  amountHalalas Int
  durationDays  Int?
  effectiveFrom DateTime
  /// null تعني «سارٍ حتى إشعار آخر»
  effectiveTo   DateTime?
  note          String?
  createdById   String?
  createdAt     DateTime  @default(now())

  item       PricingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy  AdminUser?  @relation("PricingAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  promotions Promotion[]

  @@index([itemId, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
  @@map("pricing_versions")
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  adId            String?
  tickerRequestId String?
  amountHalalas   Int
  currency        String        @default("SAR")
  status          PaymentStatus @default(PENDING)
  provider        String
  providerRef     String?
  checkoutUrl     String?
  items           Json
  meta            Json?
  failureReason   String?
  paidAt          DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ad            Ad?              @relation(fields: [adId], references: [id], onDelete: SetNull)
  tickerRequest TickerRequest?   @relation(fields: [tickerRequestId], references: [id], onDelete: SetNull)
  promotions    Promotion[]
  attempts      PaymentAttempt[]
  refunds       Refund[]
  invoice       Invoice?

  @@unique([provider, providerRef])
  @@index([userId, createdAt])
  @@index([status])
  @@map("payments")
}

model Promotion {
  id            String        @id @default(cuid())
  adId          String
  type          PromotionType
  amountHalalas Int           @default(0)
  /// إصدار السعر الذي طُبِّق فعليًا وقت الشراء
  pricingVersionId String?
  paymentId     String?
  startsAt      DateTime      @default(now())
  endsAt        DateTime?
  metadata      Json?
  createdAt     DateTime      @default(now())

  ad             Ad              @relation(fields: [adId], references: [id], onDelete: Cascade)
  payment        Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  pricingVersion PricingVersion? @relation(fields: [pricingVersionId], references: [id], onDelete: SetNull)

  @@index([adId, type])
  @@index([endsAt])
  @@map("promotions")
}

/// كل محاولة تعامل مع بوابة الدفع، للتشخيص وتتبّع النزاعات.
model PaymentAttempt {
  id           String               @id @default(cuid())
  paymentId    String
  provider     String
  providerRef  String?
  status       PaymentAttemptStatus @default(STARTED)
  errorCode    String?
  errorMessage String?
  payload      Json?
  createdAt    DateTime             @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

/// استرداد كلي أو جزئي لعملية دفع.
model Refund {
  id                 String       @id @default(cuid())
  paymentId          String
  amountHalalas      Int
  reason             String
  status             RefundStatus @default(PENDING)
  providerRef        String?
  failureReason      String?
  requestedByAdminId String?
  createdAt          DateTime     @default(now())
  completedAt        DateTime?

  payment          Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  requestedByAdmin AdminUser? @relation("RefundRequester", fields: [requestedByAdminId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

/// فاتورة ضريبية بترقيم تسلسلي لا يتكرر.
model Invoice {
  id               String   @id @default(cuid())
  paymentId        String   @unique
  number           String   @unique
  issuedAt         DateTime @default(now())
  subtotalHalalas  Int
  vatHalalas       Int
  totalHalalas     Int
  vatRateBps       Int      @default(1500)
  buyerName        String?
  buyerPhone       String
  buyerVatNumber   String?
  sellerName       String
  sellerVatNumber  String?
  lines            Json

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([issuedAt])
  @@map("invoices")
}

/// عدّاد تسلسلي للفواتير لكل سنة — يضمن ترقيمًا متصلًا بلا فجوات.
model InvoiceCounter {
  year      Int      @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("invoice_counters")
}

// ---------------------------------------------------------------------------
// الخصوصية وحماية البيانات (PDPL)
// ---------------------------------------------------------------------------

/// سجل موافقة موثّق بإصداره ووقته ومصدره.
model ConsentRecord {
  id        String      @id @default(cuid())
  userId    String
  type      ConsentType
  version   String
  granted   Boolean     @default(true)
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@map("consent_records")
}

/// طلب تصدير أو حذف البيانات الشخصية.
model UserDataRequest {
  id             String            @id @default(cuid())
  userId         String
  type           DataRequestType
  status         DataRequestStatus @default(PENDING)
  note           String?
  resultKey      String?
  handledById    String?
  createdAt      DateTime          @default(now())
  completedAt    DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  handledBy AdminUser? @relation("DataRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@map("user_data_requests")
}

// ---------------------------------------------------------------------------
// الشريط الإعلاني العلوي (شعارات فقط — غير قابل للنقر)
// ---------------------------------------------------------------------------

model TickerRequest {
  id            String       @id @default(cuid())
  userId        String
  businessName  String
  logoMediaId   String
  status        TickerStatus @default(DRAFT)
  requestedDays Int          @default(30)
  startsAt      DateTime?
  endsAt        DateTime?
  sortWeight    Int          @default(0)
  note          String?
  reviewNote    String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logoMedia  MediaAsset @relation(fields: [logoMediaId], references: [id])
  reviewedBy AdminUser? @relation("TickerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  payments   Payment[]

  @@index([status, startsAt])
  @@index([userId])
  @@map("ticker_requests")
}

// ---------------------------------------------------------------------------
// الإشعارات
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  titleAr   String
  titleEn   String
  bodyAr    String
  bodyEn    String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// التحليلات
// ---------------------------------------------------------------------------

model AdEvent {
  id         String           @id @default(cuid())
  adId       String
  userId     String?
  deviceId   String
  type       AdEventType
  source     ImpressionSource @default(ORGANIC)
  cityId     String?
  watchedMs  Int?
  completed  Boolean          @default(false)
  createdAt  DateTime         @default(now())

  ad   Ad    @relation(fields: [adId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  city City? @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([adId, type, createdAt])
  @@index([adId, deviceId, type])
  @@index([createdAt])
  @@map("ad_events")
}

/// درجة جودة الإعلان — يعيد بناءها العامل دوريًا من جدول الأحداث.
/// موجودة كجدول منفصل حتى لا يثقل حسابها استعلامات الموجز.
model AdScore {
  adId        String   @id
  impressions Int      @default(0)
  clicks      Int      @default(0)
  saves       Int      @default(0)
  videoViews  Int      @default(0)
  completions Int      @default(0)
  /// درجة الجودة (٠ إلى ١) محسوبة بحدّ ويلسون الأدنى
  quality     Float    @default(0)
  updatedAt   DateTime @updatedAt

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([quality])
  @@map("ad_scores")
}

/// تقارب المستخدم مع كل قسم، مستخلص من تفاعلاته السابقة.
model UserCategoryAffinity {
  userId      String
  categoryId  String
  clicks      Int      @default(0)
  saves       Int      @default(0)
  impressions Int      @default(0)
  score       Float    @default(0)
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([userId, score])
  @@map("user_category_affinities")
}

model AdDailyStat {
  id             String   @id @default(cuid())
  adId           String
  date           DateTime @db.Date
  impressions    Int      @default(0)
  uniqueReach    Int      @default(0)
  videoViews     Int      @default(0)
  completions    Int      @default(0)
  totalWatchedMs BigInt   @default(0)
  clicksWhatsapp Int      @default(0)
  clicksCall     Int      @default(0)
  clicksStore    Int      @default(0)
  clicksLink     Int      @default(0)
  saves          Int      @default(0)
  shares         Int      @default(0)
  organic        Int      @default(0)
  promoted       Int      @default(0)

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, date])
  @@index([date])
  @@map("ad_daily_stats")
}

// ---------------------------------------------------------------------------
// الإعدادات وسجل الإجراءات
// ---------------------------------------------------------------------------

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("app_settings")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorAdminId String?
  actorUserId  String?
  action       String
  entityType   String
  entityId     String?
  before       Json?
  after        Json?
  reason       String?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  actorAdmin AdminUser? @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorAdminId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
