generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  INDIVIDUAL
  STORE
  BRAND
  COMPANY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum StaffRole {
  SUPER_ADMIN
  ADS_MODERATOR
  SUPPORT
  CAMPAIGN_MANAGER
  FINANCE_MANAGER
  CONTENT_MANAGER
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaStatus {
  UPLOADING
  QUEUED
  PROCESSING
  READY
  REJECTED
  FAILED
}

enum AdStatus {
  DRAFT
  AWAITING_PAYMENT
  ACTIVE
  PAUSED
  EXPIRED
  REMOVED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  REMOVED
}

enum DisplayScope {
  CITY
  KINGDOM
}

enum ContactType {
  STORE
  PRODUCT
  WHATSAPP
  PHONE
  EXTERNAL
}

enum ModerationResult {
  SAFE
  NEEDS_REVIEW
  BLOCKED
}

enum BannerStatus {
  DRAFT
  AWAITING_PAYMENT
  AWAITING_REVIEW
  APPROVED
  ACTIVE
  REJECTED
  EXPIRED
  PAUSED
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
  APPEALED
}

enum AppealStatus {
  OPEN
  ACCEPTED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  PUSH
}

enum AnalyticsSource {
  ORGANIC
  PAID
}

model User {
  id                 String           @id @default(uuid())
  phone              String           @unique
  email              String?          @unique
  name               String?
  accountType        AccountType?
  status             UserStatus       @default(ACTIVE)
  staffRole          StaffRole?
  profileCompletedAt DateTime?
  avatarUrl          String?
  acceptedTermsAt    DateTime?
  cityId             String?
  city               City?            @relation(fields: [cityId], references: [id])
  businessProfile    BusinessProfile?
  sessions           Session[]
  otpChallenges      OtpChallenge[]
  media              MediaAsset[]
  ads                Ad[]
  posts              ProfilePost[]
  banners            BannerRequest[]
  favorites          Favorite[]
  postFavorites      PostFavorite[]
  reports            Report[]         @relation("Reporter")
  reportActions      Report[]         @relation("ReportActionBy")
  appeals            Appeal[]         @relation("AppealOwner")
  resolvedAppeals    Appeal[]         @relation("AppealResolver")
  notifications      Notification[]
  analyticsEvents    AnalyticsEvent[]
  orders             PaymentOrder[]
  auditLogs          AuditLog[]       @relation("AuditActor")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([cityId])
  @@index([staffRole])
}

model BusinessProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String?
  logoUrl     String?
  coverUrl    String?
  websiteUrl  String?
  storeUrl    String?
  whatsapp    String?
  socialLinks Json?
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastSeenAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  @@index([userId, revokedAt])
}

model OtpChallenge {
  id          String    @id @default(uuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String
  codeHash    String
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())

  @@index([phone, createdAt])
}

model Region {
  id        String   @id @default(uuid())
  slug      String   @unique
  nameAr    String
  nameEn    String
  active    Boolean  @default(true)
  cities    City[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model City {
  id        String           @id @default(uuid())
  regionId  String
  region    Region           @relation(fields: [regionId], references: [id])
  slug      String           @unique
  nameAr    String
  nameEn    String
  latitude  Decimal?         @db.Decimal(9, 6)
  longitude Decimal?         @db.Decimal(9, 6)
  active    Boolean          @default(true)
  users     User[]
  ads       Ad[]
  events    AnalyticsEvent[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([regionId, active])
}

model Category {
  id        String     @id @default(uuid())
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  slug      String     @unique
  nameAr    String
  nameEn    String
  icon      String?
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  ads       Ad[]       @relation("AdCategory")
  subAds    Ad[]       @relation("AdSubcategory")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId, active, sortOrder])
}

model MediaAsset {
  id             String            @id @default(uuid())
  ownerId        String
  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind           MediaKind
  status         MediaStatus       @default(UPLOADING)
  originalKey    String            @unique
  optimizedKey   String?
  thumbnailKey   String?
  blurHash       String?
  mimeType       String
  sizeBytes      Int
  width          Int?
  height         Int?
  durationMs     Int?
  moderation     ModerationResult?
  rejectionCode  String?
  ads            AdMedia[]
  posts          PostMedia[]
  bannerRequests BannerRequest[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([ownerId, status])
}

model Ad {
  id               String             @id @default(uuid())
  ownerId          String
  owner            User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categoryId       String
  category         Category           @relation("AdCategory", fields: [categoryId], references: [id])
  subcategoryId    String
  subcategory      Category           @relation("AdSubcategory", fields: [subcategoryId], references: [id])
  cityId           String
  city             City               @relation(fields: [cityId], references: [id])
  title            String
  description      String?
  price            Decimal?           @db.Decimal(12, 2)
  scope            DisplayScope
  status           AdStatus           @default(DRAFT)
  contactType      ContactType
  contactValue     String
  moderation       ModerationResult   @default(SAFE)
  featuredUntil    DateTime?
  sponsoredUntil   DateTime?
  topCategoryUntil DateTime?
  activatedAt      DateTime?
  expiresAt        DateTime?
  removedAt        DateTime?
  media            AdMedia[]
  targetCities     AdTargetCity[]
  favorites        Favorite[]
  reports          Report[]
  analyticsEvents  AnalyticsEvent[]
  metrics          AdMetricDaily[]
  orderItems       PaymentOrderItem[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([categoryId, status, createdAt])
  @@index([cityId, status, createdAt])
  @@index([ownerId, status])
}

model AdMedia {
  adId      String
  ad        Ad         @relation(fields: [adId], references: [id], onDelete: Cascade)
  mediaId   String
  media     MediaAsset @relation(fields: [mediaId], references: [id])
  sortOrder Int

  @@id([adId, mediaId])
  @@unique([adId, sortOrder])
}

model AdTargetCity {
  adId   String
  ad     Ad     @relation(fields: [adId], references: [id], onDelete: Cascade)
  cityId String

  @@id([adId, cityId])
}

model ProfilePost {
  id          String         @id @default(uuid())
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  body        String?
  status      PostStatus     @default(DRAFT)
  publishedAt DateTime?
  media       PostMedia[]
  favorites   PostFavorite[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([ownerId, status, createdAt])
}

model PostMedia {
  postId    String
  post      ProfilePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaId   String
  media     MediaAsset  @relation(fields: [mediaId], references: [id])
  sortOrder Int

  @@id([postId, mediaId])
  @@unique([postId, sortOrder])
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adId      String
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, adId])
}

model PostFavorite {
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      ProfilePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([userId, postId])
}

model BannerRequest {
  id           String             @id @default(uuid())
  ownerId      String
  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mediaId      String
  media        MediaAsset         @relation(fields: [mediaId], references: [id])
  status       BannerStatus       @default(DRAFT)
  reviewReason String?
  startsAt     DateTime?
  endsAt       DateTime?
  orderItems   PaymentOrderItem[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, startsAt, endsAt])
}

model Price {
  id            String   @id @default(uuid())
  code          String   @unique
  nameAr        String
  nameEn        String
  amountHalalas Int
  currency      String   @default("SAR")
  active        Boolean  @default(true)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model PaymentOrder {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  status          PaymentStatus      @default(PENDING)
  totalHalalas    Int
  currency        String             @default("SAR")
  provider        String
  providerOrderId String?            @unique
  idempotencyKey  String             @unique
  items           PaymentOrderItem[]
  attempts        PaymentAttempt[]
  paidAt          DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model PaymentOrderItem {
  id            String         @id @default(uuid())
  orderId       String
  order         PaymentOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  priceCode     String
  amountHalalas Int
  quantity      Int            @default(1)
  adId          String?
  ad            Ad?            @relation(fields: [adId], references: [id])
  bannerId      String?
  banner        BannerRequest? @relation(fields: [bannerId], references: [id])
}

model PaymentAttempt {
  id              String        @id @default(uuid())
  orderId         String
  order           PaymentOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerEventId String?       @unique
  status          PaymentStatus
  response        Json?
  createdAt       DateTime      @default(now())
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String
  reporter     User         @relation("Reporter", fields: [reporterId], references: [id])
  adId         String
  ad           Ad           @relation(fields: [adId], references: [id], onDelete: Cascade)
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  actionById   String?
  actionBy     User?        @relation("ReportActionBy", fields: [actionById], references: [id])
  actionReason String?
  reviewedAt   DateTime?
  appeals      Appeal[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([reporterId, adId, reason])
  @@index([status, createdAt])
}

model Appeal {
  id           String       @id @default(uuid())
  reportId     String
  report       Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  ownerId      String
  owner        User         @relation("AppealOwner", fields: [ownerId], references: [id])
  message      String
  status       AppealStatus @default(OPEN)
  resolvedById String?
  resolvedBy   User?        @relation("AppealResolver", fields: [resolvedById], references: [id])
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  channel   NotificationChannel @default(IN_APP)
  titleAr   String
  titleEn   String
  bodyAr    String
  bodyEn    String
  data      Json?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt, createdAt])
}

model AnalyticsEvent {
  id             String          @id @default(uuid())
  adId           String
  ad             Ad              @relation(fields: [adId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id])
  anonymousId    String?
  cityId         String?
  city           City?           @relation(fields: [cityId], references: [id])
  type           String
  watchMs        Int?
  source         AnalyticsSource @default(ORGANIC)
  idempotencyKey String          @unique
  occurredAt     DateTime        @default(now())

  @@index([adId, occurredAt])
}

model AdMetricDaily {
  id            String   @id @default(uuid())
  adId          String
  ad            Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  impressions   Int      @default(0)
  uniqueReach   Int      @default(0)
  videoViews    Int      @default(0)
  watchMs       BigInt   @default(0)
  completions   Int      @default(0)
  contactClicks Int      @default(0)
  saves         Int      @default(0)
  shares        Int      @default(0)

  @@unique([adId, date])
  @@index([date])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
