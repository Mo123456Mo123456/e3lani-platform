# Runtime
NODE_ENV=development
PORT=3000
EXPO_PORT=8081

# Database — server only
DATABASE_URL=mysql://user:password@127.0.0.1:3306/e3lani

# Session and OAuth — server only
JWT_SECRET=replace-with-a-long-random-secret
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=

# Built-in server capabilities / object storage proxy — server only
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Expo public configuration — never put secrets in EXPO_PUBLIC_* values
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=

# Product modes
FEED_ACCESS_MODE=FREE_LAUNCH

# Payment remains disabled until a reviewed provider adapter and verified webhook are configured
PAYMENT_ENABLED=false
PAYMENT_PROVIDER=disabled
PAYMENT_WEBHOOK_SECRET=
