# ═══════════════════════════════════════════════════════════
# كوكب يولد أمامك — Environment Variables
# Copy to .env and adjust. Never commit real secrets.
# ═══════════════════════════════════════════════════════════

NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
REALTIME_URL=ws://localhost:4001
SIMULATION_URL=http://localhost:8001
AI_ORCHESTRATOR_URL=http://localhost:8002

# Database
DATABASE_URL=postgresql://planet:planet_dev@localhost:5432/planet_born?schema=public
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false

# World
DEFAULT_PLANET_SEED=planet-born-alpha-2026
SIMULATION_TICK_UNIT=year
SIMULATION_AUTO_TICK=false

# AI Providers (leave empty to use sandbox/mock provider)
AI_PROVIDER=sandbox
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_SANDBOX_MODE=true

# Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=planet-born
S3_REGION=us-east-1

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# Sandbox Super Admin (documented in README — change in production)
SANDBOX_ADMIN_EMAIL=admin@planet-born.local
SANDBOX_ADMIN_PASSWORD=PlanetAdmin!2026
SANDBOX_USER_EMAIL=explorer@planet-born.local
SANDBOX_USER_PASSWORD=Explorer!2026
