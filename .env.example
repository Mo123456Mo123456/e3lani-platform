# ============================================================================
#  إعلاني | E3lani — نموذج متغيرات البيئة
#  انسخ هذا الملف إلى .env في جذر المستودع ثم عدّل القيم.
#  cp .env.example .env
# ============================================================================

NODE_ENV=development

# ----------------------------------------------------------------------------
# قاعدة البيانات (PostgreSQL)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://e3lani:e3lani@localhost:5432/e3lani?schema=public

# ----------------------------------------------------------------------------
# Redis (طوابير BullMQ + الحد من المعدل + الكاش)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# خدمة الـ API
# ----------------------------------------------------------------------------
API_PORT=4000
API_PREFIX=api
# نطاقات مسموح بها للـ CORS (مفصولة بفواصل)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# ----------------------------------------------------------------------------
# JWT — استبدل كل القيم في الإنتاج بقيم عشوائية طويلة
#   openssl rand -base64 48
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
ADMIN_JWT_SECRET=change-me-admin-secret-min-32-characters-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
ADMIN_JWT_TTL=28800

# ----------------------------------------------------------------------------
# رمز التحقق OTP (Adapter Pattern)
# OTP_PROVIDER = console | taqnyat | unifonic | msegat
#   console  : للتطوير فقط — يُطبع الرمز في سجل الخادم ولا يظهر للمستخدم أبدًا
#   taqnyat  : https://taqnyat.sa
#   unifonic : https://unifonic.com
#   msegat   : https://msegat.com
# ----------------------------------------------------------------------------
OTP_PROVIDER=console
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_SENDER_NAME=E3lani

TAQNYAT_API_KEY=
TAQNYAT_SENDER=
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=
MSEGAT_USERNAME=
MSEGAT_API_KEY=
MSEGAT_SENDER=

# ----------------------------------------------------------------------------
# التخزين المتوافق مع S3 (MinIO محليًا / S3 أو R2 في الإنتاج)
# ----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=e3lani-media
S3_ACCESS_KEY_ID=e3lani
S3_SECRET_ACCESS_KEY=e3lani-secret
S3_FORCE_PATH_STYLE=true
# الرابط العام للوسائط (CDN في الإنتاج)
S3_PUBLIC_URL=http://localhost:9000/e3lani-media
S3_UPLOAD_URL_TTL=900

# ----------------------------------------------------------------------------
# حدود الوسائط
# ----------------------------------------------------------------------------
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_MAX_VIDEO_SECONDS=60
MEDIA_MAX_IMAGES_PER_AD=5

# ----------------------------------------------------------------------------
# المدفوعات (Adapter Pattern) — معطّلة افتراضيًا (النشر مجاني حاليًا)
# PAYMENT_PROVIDER = sandbox | moyasar | tap | hyperpay
# لا يُسمح بمزوّد sandbox عندما تكون NODE_ENV=production
# ----------------------------------------------------------------------------
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=sandbox
PAYMENT_CURRENCY=SAR
PAYMENT_RETURN_URL=http://localhost:3000/payments/callback

MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
TAP_SECRET_KEY=
TAP_WEBHOOK_SECRET=
HYPERPAY_ENTITY_ID=
HYPERPAY_ACCESS_TOKEN=

# ----------------------------------------------------------------------------
# الإشعارات (Expo Push افتراضيًا — لا يحتاج مفتاحًا في وضع التطوير)
# PUSH_PROVIDER = none | expo | fcm
# ----------------------------------------------------------------------------
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=
FCM_SERVICE_ACCOUNT_JSON=

# ----------------------------------------------------------------------------
# الحد من المعدل (Rate Limiting)
# ----------------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
RATE_LIMIT_AUTH_LIMIT=10

# ----------------------------------------------------------------------------
# حساب الإدارة الأول (يُنشأ بواسطة أمر seed فقط)
# غيّر كلمة المرور فورًا بعد أول دخول، ولا تستخدم هذه القيم في الإنتاج.
# ----------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@e3lani.sa
SEED_SUPER_ADMIN_PASSWORD=E3lani!Admin2026
SEED_DEMO_DATA=true

# ----------------------------------------------------------------------------
# تطبيقات الواجهة
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/e3lani-media
ADMIN_PORT=3001
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_MEDIA_URL=http://localhost:9000/e3lani-media
EXPO_PUBLIC_SITE_URL=http://localhost:3000
