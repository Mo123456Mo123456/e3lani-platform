# Runtime mode: sandbox allows deterministic local adapters; production fails closed.
APP_ENV=sandbox
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# PostgreSQL with PostGIS and pgvector (provided by compose.yaml)
DATABASE_URL=postgresql://planet:planet_dev_only@localhost:5432/planet
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
AI_ORCHESTRATOR_URL=http://localhost:8001
JWT_SECRET=replace-with-at-least-32-random-characters

# AI providers are optional in sandbox. Production must configure at least one.
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=planet
S3_ACCESS_KEY=planet
S3_SECRET_KEY=replace-me
