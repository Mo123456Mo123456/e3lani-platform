# Runtime
NODE_ENV=development
PORT=4000
WORLD_SEED=azura-prime-7
WORLD_STORE=memory
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SANDBOX_MODE=true

# Production persistence and event bus
DATABASE_URL=postgres://planet:planet@localhost:5432/living_planet
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=planet
S3_SECRET_KEY=replace-me
S3_BUCKET=world-assets
INTERNAL_SERVICE_TOKEN=replace-with-a-random-service-token
AI_ORCHESTRATOR_URL=http://localhost:8100

# AI orchestrator: sandbox is rejected when APP_ENV=production
APP_ENV=development
AI_PROVIDER=sandbox
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_COMPATIBLE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_COMPATIBLE_URL=
LOCAL_AI_API_KEY=local
LOCAL_AI_MODEL=
LOCAL_AI_URL=http://localhost:11434/v1/chat/completions

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
