# ---------------------------------------------------------------------------
# Planet Genesis — environment template. Copy to .env and fill what you need.
# Everything works WITHOUT any external key (documented sandbox mode).
# ---------------------------------------------------------------------------

# --- API (services/api) -----------------------------------------------------
NODE_ENV=development
PORT=4100
HOST=0.0.0.0

# PostgreSQL — when empty, the API runs on the in-memory sandbox repository
DATABASE_URL=
# DATABASE_URL=postgres://planet:planet@localhost:5432/planet_genesis

# Optional infrastructure (event bus / cache adapters — not required yet)
REDIS_URL=
NATS_URL=

# Auth — REQUIRED to change in production (boot fails otherwise)
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# AI orchestration — when empty, the API uses its built-in deterministic
# sandbox analyzer (labeled provider "mock")
AI_ORCHESTRATOR_URL=
# AI_ORCHESTRATOR_URL=http://localhost:8100
AI_PROVIDER=mock            # mock | openai | anthropic | gemini

# Scientific simulation service — when empty, Monte Carlo runs in-process
SIM_ENGINE_URL=
# SIM_ENGINE_URL=http://localhost:8200

CORS_ORIGINS=http://localhost:3000,http://localhost:3100
RATE_LIMIT_MAX=120

# Default planet
DEFAULT_PLANET_SEED=planet-genesis-prime
YEARS_PER_TICK=5
AUTO_TICK=false
AUTO_TICK_INTERVAL_MS=4000

# --- Python services ----------------------------------------------------------
# services/ai-orchestrator
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Web (apps/web) -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4100

# --- Admin (apps/admin) -------------------------------------------------------------
API_URL=http://localhost:4100

# --- Sandbox accounts (created at boot when missing; documented in README) --------
# admin@planet.local     / planet-admin-2026     (super_admin)
# explorer@planet.local  / planet-explorer-2026  (explorer)
