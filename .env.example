# ─── core ────────────────────────────────────────────────────────────────
NODE_ENV=development
# PostgreSQL (PostGIS image recommended; plain postgres also works)
DATABASE_URL=postgresql://kawkab:kawkab@localhost:5432/kawkab
REDIS_URL=redis://localhost:6379

# ─── API ─────────────────────────────────────────────────────────────────
PORT=4000
# REQUIRED in production — long random strings
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# ─── AI providers (all optional — without keys the platform runs the
# deterministic sandbox provider and labels its output transparently) ─────
AI_PROVIDER=mock            # mock | openai | anthropic | gemini
AI_ORCHESTRATOR_URL=http://localhost:4100
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ─── OAuth (optional — endpoints return 501 until configured) ────────────
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ─── object storage (optional, S3-compatible) ────────────────────────────
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── apps ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── demo seed ───────────────────────────────────────────────────────────
DEMO_PLANET_SEED=kawkab-aether-144
SEED_TICKS=80

# ─── standalone simulation worker (optional) ─────────────────────────────
WORKER_PLANET_IDS=
TICKS_PER_SECOND=1
