# ─── كوكب يولد أمامك — environment example ───
# Copy to .env and adjust.

# Database (local API uses SQLite; Postgres for docker/prod)
DATABASE_URL=postgresql://planet:planet@localhost:5432/planet
SQLITE_PATH=./data/planet.db

# Auth
JWT_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
SUPER_ADMIN_EMAIL=admin@planet.local
SUPER_ADMIN_PASSWORD=Admin@Planet2026!
INTERNAL_API_KEY=dev-internal

# AI providers
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Service URLs
API_PORT=4000
API_URL=http://localhost:4000
HOST=0.0.0.0
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
SIM_ENGINE_URL=http://localhost:8001
AI_ORCHESTRATOR_URL=http://localhost:8002
REALTIME_URL=http://localhost:4001
REALTIME_PORT=4001
WORLD_GEN_PORT=4002
NOTIFICATION_POLL_MS=5000

# Rate limit
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute

# Object storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=planet
S3_FORCE_PATH_STYLE=true

# Messaging (optional — local uses in-memory / SQLite poll)
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# Feature flags
USE_LOCAL_SIM=true
USE_LOCAL_AI_MOCK=true
