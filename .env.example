# Planet Born Before You / كوكب يولد أمامك
NODE_ENV=development

# Public apps
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4010
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Services
API_PORT=4000
ADMIN_PORT=3001
WEB_PORT=3000
REALTIME_PORT=4010
SIMULATION_TICK_MS=2000
SIMULATION_SEED=kawkab-demo-seed

# Database: if absent, API uses local SQLite file ./data/kawkab.sqlite
DATABASE_URL=postgres://kawkab:kawkab@localhost:5432/kawkab
SQLITE_PATH=./data/kawkab.sqlite

# Auth
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too
SANDBOX_ADMIN_EMAIL=admin@kawkab.local
SANDBOX_ADMIN_PASSWORD=change-me-admin

# Optional AI providers. Mock provider works without keys.
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional object storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kawkab-assets

# Feature flags
FEATURE_AI=true
FEATURE_MULTIPLAYER=true
FEATURE_ADMIN=true
FEATURE_COST_TRACKING=false
