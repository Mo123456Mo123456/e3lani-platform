# ============================================================
# كوكب يولد أمامك — Environment template / قالب المتغيرات
# Copy to .env and fill values. NEVER commit real secrets.
# ============================================================

# ---------- Core ----------
NODE_ENV=development
APP_LOCALE_DEFAULT=ar

# ---------- Database (PostgreSQL + PostGIS + pgvector) ----------
DATABASE_URL=postgres://planet:planet@localhost:5432/planet_born

# ---------- Cache / Bus ----------
# If unset, the API falls back to in-process bus & cache (single-node dev).
REDIS_URL=redis://localhost:6379
# Optional NATS JetStream. If unset, Redis/in-process bus is used.
NATS_URL=nats://localhost:4222

# ---------- Object storage (S3-compatible; MinIO in compose) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=planet-assets
S3_ACCESS_KEY=planetminio
S3_SECRET_KEY=planetminio123

# ---------- Services ----------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
SIMULATION_ENGINE_URL=http://localhost:8001
AI_ORCHESTRATOR_URL=http://localhost:8002
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ---------- Auth ----------
# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
COOKIE_SECURE=false

# OAuth (optional; disabled when absent — see docs/SECURITY.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ---------- Simulation ----------
SIM_TICK_SECONDS=5
SIM_YEARS_PER_TICK=1
SIM_DEFAULT_SEED=42
SIM_AUTO_RUN=false

# ---------- AI providers (optional; Mock/Sandbox provider used when absent) ----------
AI_PROVIDER_DEFAULT=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_MAX_TOKENS=2048
AI_MONTHLY_COST_BUDGET_USD=50

# ---------- Sandbox accounts (documented in README; change before production) ----------
SEED_SUPER_ADMIN_EMAIL=admin@planet.local
SEED_SUPER_ADMIN_PASSWORD=PlanetAdmin!234
SEED_DEMO_USER_EMAIL=demo@planet.local
SEED_DEMO_USER_PASSWORD=PlanetDemo!234

# ---------- Web / Admin (public) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
