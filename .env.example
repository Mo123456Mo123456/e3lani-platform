# Runtime
NODE_ENV=development
PORT=3000
VITE_APP_ID=living-planet-local
JWT_SECRET=replace-with-at-least-32-random-characters

# Existing server persistence (optional for the local simulation sandbox)
DATABASE_URL=mysql://user:password@localhost:3306/living_planet
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Existing object storage adapter
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Future AI provider adapters. The current UI deliberately uses the disclosed
# deterministic Sandbox analyzer until a server-side adapter is configured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=sandbox
