# ═══════════════════════════════════════════════════════════
# كوكب يولد أمامك — Environment Variables
# Copy to .env and adjust. Never commit real secrets.
# ═══════════════════════════════════════════════════════════

NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
AI_ORCHESTRATOR_URL=http://localhost:5001
SIMULATION_ENGINE_URL=http://localhost:4001

# PostgreSQL
DATABASE_URL=postgresql://planet:planet_dev@localhost:5432/planet_born

# Redis
REDIS_URL=redis://localhost:6379

# Auth (change in production)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false

# World
DEFAULT_PLANET_SEED=42424242
DEFAULT_TICK_UNIT=year

# AI Providers — leave empty to use Sandbox/Mock provider
AI_PROVIDER=sandbox
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_SANDBOX_MODE=true

# Storage (S3-compatible) — optional in sandbox
S3_ENDPOINT=
S3_BUCKET=planet-born
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Super Admin (sandbox only — documented in README)
SUPER_ADMIN_EMAIL=admin@planet-born.local
SUPER_ADMIN_PASSWORD=PlanetAdmin!2026
SUPER_ADMIN_NAME=Super Admin

# Demo user
DEMO_USER_EMAIL=explorer@planet-born.local
DEMO_USER_PASSWORD=Explorer!2026

# Observability
OTEL_ENABLED=false
LOG_LEVEL=info
