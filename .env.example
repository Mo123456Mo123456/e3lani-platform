# ─── Platform ───────────────────────────────────────────
NODE_ENV=development
APP_NAME=كوكب يولد أمامك
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
SIMULATION_URL=http://localhost:8001
AI_ORCHESTRATOR_URL=http://localhost:8002
WS_URL=ws://localhost:4000/ws

# ─── Database (PostgreSQL) ──────────────────────────────
DATABASE_URL=postgresql://planet:planet@localhost:5432/planet_born
REDIS_URL=redis://localhost:6379

# ─── Auth ───────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ISSUER=planet-born
JWT_AUDIENCE=planet-born-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_SECURE=false

# ─── World ──────────────────────────────────────────────
DEFAULT_PLANET_SEED=planet-born-alpha-2026
TICK_INTERVAL_MS=5000
TICK_YEARS=1

# ─── AI Providers (optional — sandbox used when absent) ─
AI_PROVIDER=sandbox
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_SANDBOX_MODE=true

# ─── Storage (S3-compatible, optional) ──────────────────
S3_ENDPOINT=
S3_BUCKET=planet-born
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ─── Event Bus ──────────────────────────────────────────
NATS_URL=
EVENT_BUS=memory

# ─── Observability ──────────────────────────────────────
LOG_LEVEL=info
OTEL_ENABLED=false

# ─── Sandbox Super Admin (documented only — change in prod)
SANDBOX_ADMIN_EMAIL=admin@planet-born.local
SANDBOX_ADMIN_PASSWORD=PlanetAdmin!2026
SANDBOX_USER_EMAIL=explorer@planet-born.local
SANDBOX_USER_PASSWORD=Explorer!2026
