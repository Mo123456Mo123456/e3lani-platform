NODE_ENV=development
APP_ENV=development
DATABASE_URL=postgresql://e3lani:e3lani@localhost:5432/e3lani?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
OTP_MODE=sandbox
OTP_PROVIDER=sandbox
PAYMENT_MODE=sandbox
SANDBOX_PAYMENT_WEBHOOK_SECRET=e3lani-sandbox-webhook-secret
API_PUBLIC_URL=http://localhost:3001

# --- Object storage (S3-compatible) ---
# Local MinIO (docker-compose):
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=e3lani
S3_ACCESS_KEY_ID=e3lani
S3_SECRET_ACCESS_KEY=e3lanisecret
S3_PUBLIC_BASE_URL=http://localhost:9000/e3lani
S3_FORCE_PATH_STYLE=true

# Cloudflare R2 (staging/production) — set in Render dashboard, never commit secrets:
# STORAGE_PROVIDER=r2
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=<bucket-name>
# S3_ACCESS_KEY_ID=<r2-access-key-id>
# S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
# S3_PUBLIC_BASE_URL=   # leave empty for private bucket + signed GET URLs
# S3_FORCE_PATH_STYLE=false
