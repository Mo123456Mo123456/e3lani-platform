# E3lani runtime mode
# Allowed values: ONLY_PROFILE | LAUNCH_FREE | ONLY_PAID
# Keep LAUNCH_FREE for the current free launch. ONLY_PAID must not be enabled
# until a production payment provider and server-side verification are ready.
FEED_ACCESS_MODE=LAUNCH_FREE

# Server and database
DATABASE_URL=mysql://user:password@localhost:3306/e3lani
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-long-random-secret

# Public application endpoints
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_WEB_BASE_URL=https://example.com

# Object storage (configure real values outside source control)
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=e3lani-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
