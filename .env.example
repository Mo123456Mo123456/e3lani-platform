NODE_ENV=development
APP_ENV=development
DATABASE_URL=postgresql://e3lani:e3lani@localhost:5432/e3lani?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
# Launch mode is stored in DB (SystemSetting launch_mode). Default after seed: FREE_LAUNCH
# FREE_LAUNCH | PAID_ONLY | PROFILE_ONLY
# Recommendation adapter: heuristic (default) | embeddings (requires real provider)
RECOMMENDATION_ADAPTER=heuristic
OTP_MODE=sandbox
OTP_PROVIDER=sandbox
# Sandbox OTP code is 123456 — logged server-side only, never returned to clients.
# Production OTP placeholders (leave unset in sandbox):
# OTP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
PAYMENT_MODE=sandbox
SANDBOX_PAYMENT_WEBHOOK_SECRET=e3lani-sandbox-webhook-secret
# Never enable fake payment success when PAYMENT_MODE=production.
# Production payment placeholders:
# PAYMENT_MODE=production
# PAYMENT_PROVIDER=moyasar
# Moyasar live keys (required when PAYMENT_PROVIDER=moyasar):
# MOYASAR_SECRET_KEY=
# MOYASAR_PUBLISHABLE_KEY=
# MOYASAR_WEBHOOK_SECRET=
# MOYASAR_API_BASE_URL=https://api.moyasar.com/v1
# MYFATOORAH_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
API_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# --- Object storage ---
# Staging / Render Free (no R2 secrets required):
# STORAGE_PROVIDER=sandbox
# STORAGE_MODE=sandbox
# SANDBOX_STORAGE_ENABLED=true
# SANDBOX_STORAGE_DIR=/tmp/e3lani-sandbox-storage
# SANDBOX_STORAGE_HMAC_SECRET=change-me-local-only

# Local MinIO or Cloudflare R2 (use R2_* names only):
STORAGE_PROVIDER=r2
R2_ENDPOINT=http://localhost:9000
R2_BUCKET=e3lani
R2_ACCESS_KEY_ID=e3lani
R2_SECRET_ACCESS_KEY=e3lanisecret
# R2_PUBLIC_BASE_URL=

# Media processing: inline on Free/staging; queue when media-worker is deployed
MEDIA_PROCESSING_MODE=inline
# Optional system binary overrides for real video processing
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# Staging-only explicit fallback when ffmpeg is unavailable; unset in production.
# VIDEO_PROCESSING_FALLBACK=brand_poster

# Optional integrations (placeholders — sandbox adapters used when unset)
# NOTIFICATIONS_MODE=sandbox
# EMAIL_PROVIDER=sandbox
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMS_PROVIDER=sandbox
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# PUSH_PROVIDER=sandbox
# FCM_SERVER_KEY=
# MODERATION_MODE=sandbox
# MODERATION_PROVIDER=sandbox
# MODERATION_API_KEY=
# SENTRY_DSN=
# ANALYTICS_WRITE_KEY=
