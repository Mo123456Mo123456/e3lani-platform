# Database
DATABASE_URL=postgresql://planet:planet@localhost:5432/planet_world

# Redis / cache / queues
REDIS_URL=redis://localhost:6379

# NATS JetStream (optional in local sandbox)
NATS_URL=nats://localhost:4222

# Object storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=planet
S3_SECRET_KEY=planetsecret
S3_BUCKET=planet-assets

# Auth
JWT_SECRET=change-me-in-production-use-long-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false

# Service URLs
API_PORT=4100
AI_ORCHESTRATOR_URL=http://localhost:4101
AI_ORCHESTRATOR_PORT=4101
SIMULATION_ENGINE_URL=http://localhost:4102
SIMULATION_ENGINE_PORT=4102
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Planet defaults
DEFAULT_PLANET_SEED=42424242
DEFAULT_TICK_UNIT=year

# AI providers — leave empty to use documented Mock/Sandbox provider
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_MODEL=

# Feature flags
ENABLE_REAL_AI=false
NODE_ENV=development
