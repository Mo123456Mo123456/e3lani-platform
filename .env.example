# Core
NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:4000

# PostgreSQL / Redis
DATABASE_URL=postgresql://e3lani:e3lani_local@localhost:5432/e3lani?schema=public
REDIS_URL=redis://localhost:6379

# Authentication (generate long random values outside local development)
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-character-secret
OTP_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
# Required only when OTP_PROVIDER=unifonic
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=E3lani

# S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=e3lani-media
S3_ACCESS_KEY=e3lani
S3_SECRET_KEY=e3lani_minio_local
S3_FORCE_PATH_STYLE=true

# Payment remains disabled unless all provider/webhook values are configured
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=disabled
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# Sandbox-only administrator seed. Never use these values in production.
SEED_SANDBOX_ADMIN_PHONE=+966500000001
SEED_SANDBOX_ADMIN_NAME=مدير إعلاني التجريبي
