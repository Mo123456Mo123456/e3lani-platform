# Runtime
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# PostgreSQL / Redis
DATABASE_URL=postgresql://e3lani:e3lani_local@localhost:5432/e3lani?schema=public
REDIS_URL=redis://localhost:6379

# Authentication (replace with 32+ random bytes outside local development)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
OTP_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=E3lani

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=e3lani-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_URL=http://localhost:9000/e3lani-media

# Payments are disabled until a production adapter is configured.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=disabled
PAYMENT_WEBHOOK_SECRET=
PAYMENT_API_KEY=

# Optional providers
PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=
CONTENT_SAFETY_PROVIDER=basic
CONTENT_SAFETY_API_KEY=
SENTRY_DSN=

# Sandbox-only administrator seed. Never expose these values in clients.
SEED_ADMIN_PHONE=+966500000001
SEED_ADMIN_NAME=مدير إعلاني
