# Runtime
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# PostgreSQL / Redis
DATABASE_URL=postgresql://e3lani:e3lani@localhost:5432/e3lani?schema=public
REDIS_URL=redis://localhost:6379

# Authentication — generate long random values outside development
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
OTP_PROVIDER=console

# S3-compatible object storage (local MinIO defaults)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=e3lani
S3_ACCESS_KEY=e3lani
S3_SECRET_KEY=e3lani-local-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/e3lani

# Media
MEDIA_QUEUE_NAME=media-processing
FFMPEG_PATH=

# Payments remain disabled until a real provider is configured
PAYMENT_PROVIDER=disabled
PAYMENT_WEBHOOK_SECRET=

# OTP production adapter (choose one and implement/configure credentials)
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=E3LANI

# Optional monitoring and push notifications
SENTRY_DSN=
EXPO_ACCESS_TOKEN=
