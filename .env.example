# Runtime
NODE_ENV=development
POSTGRES_DB=kawkab
POSTGRES_USER=kawkab
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://kawkab:change-me@localhost:5432/kawkab
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Explicit development sandbox. Never enable the mock provider in production.
SANDBOX_MODE=true
SANDBOX_ADMIN_KEY=replace-with-a-long-random-sandbox-key
SANDBOX_SUPER_ADMIN_EMAIL=
SANDBOX_SUPER_ADMIN_PASSWORD=

# AI adapter: mock | openai | anthropic | gemini
AI_PROVIDER=mock
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Infrastructure
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=kawkab
S3_SECRET_KEY=change-me
S3_BUCKET=kawkab-assets

# Browser applications
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SANDBOX_MODE=false
NEXT_PUBLIC_ALLOW_SANDBOX_REGISTRATION=true
