# Shared
NODE_ENV=development
PLANET_SEED=KA-2026-07

# PostgreSQL + PostGIS + pgvector
DATABASE_URL=postgresql://planet:planet@localhost:5432/planet

# API and realtime gateway
API_PORT=4000
WEB_ORIGIN=http://localhost:3000,http://localhost:3001
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/world
NEXT_PUBLIC_SANDBOX_MODE=true

# AI orchestrator. Set AI_PROVIDER=mock only in an explicitly labelled sandbox.
AI_ORCHESTRATOR_URL=http://localhost:8000
AI_ORCHESTRATOR_TOKEN=replace-with-an-internal-service-token
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Infrastructure reserved for later workers
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=planet
S3_SECRET_KEY=replace-me
