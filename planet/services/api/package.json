{
  "name": "@planet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx --watch src/main.ts",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "node --import tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "9.4.0",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-fastify": "10.4.15",
    "@nestjs/platform-ws": "10.4.15",
    "@nestjs/websockets": "10.4.15",
    "@planet/config": "workspace:*",
    "@planet/shared-types": "workspace:*",
    "@planet/simulation-models": "workspace:*",
    "@planet/validation": "workspace:*",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "fastify": "4.28.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.9.0",
    "@types/ws": "8.5.13",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
