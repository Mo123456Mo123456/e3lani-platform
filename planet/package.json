{
  "name": "planet-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "كوكب يولد أمامك — A Planet Is Born Before You. Living procedural planet simulation platform.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './services/*' build && pnpm -r --filter './apps/*' build",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm -r --parallel run dev",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @planet/api exec prisma generate",
    "db:migrate": "pnpm --filter @planet/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @planet/api run seed",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
