# كوكب يولد أمامك — environment template. Copy to .env and fill in.

# --- Core services -------------------------------------------------------
DATABASE_URL=postgresql://planet:planet@localhost:5432/planet
ENGINE_URL=http://localhost:4100
ORCHESTRATOR_URL=http://localhost:4200
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
INTERNAL_TOKEN=dev-internal-token

# --- Security (REQUIRED in production) -----------------------------------
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
CORS_ORIGIN=*
RATE_LIMIT_PER_MINUTE=120
CONTRIBUTION_RATE_LIMIT_PER_HOUR=20

# --- AI providers (optional — mock sandbox is used when absent) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Engine sizing (defaults match the demo world) -----------------------
ENGINE_PLANT_SPECIES=800
ENGINE_ANIMAL_SPECIES=300
ENGINE_CIVILIZATIONS=12
ENGINE_DATA_DIR=./data

# --- Seed ----------------------------------------------------------------
SEED_PLANET_ID=demo-world
SEED_PLANET_SEED=20260730
SEED_HISTORY_TICKS=1000
SEED_YEARS_PER_TICK=5

# --- Workers ---------------------------------------------------------------
NOTIFY_WORLDS=demo-world
NOTIFY_POLL_MS=5000

# --- Infra (compose) -------------------------------------------------------
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=planet-assets
S3_ACCESS_KEY=planet
S3_SECRET_KEY=planetdev
