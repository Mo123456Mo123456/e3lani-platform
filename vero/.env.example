# ══════════════════════════════════════════════════════════════
#  VERO — كل زيارة لها إثبات.
#  انسخ هذا الملف إلى .env واملأ القيم قبل التشغيل:
#      cp .env.example .env
#  ثم:  docker compose up -d
#
#  ⚠ لا ترفع ملف .env إلى أي مستودع، ولا تشاركه مع أحد.
# ══════════════════════════════════════════════════════════════

# ─────────── قاعدة البيانات ───────────
POSTGRES_USER=vero
POSTGRES_DB=vero
# ولّد كلمة مرور قوية:  openssl rand -base64 24
POSTGRES_PASSWORD=

# ─────────── الأسرار (إلزامية) ───────────
# ولّد كل واحد بأمر:  openssl rand -hex 32
#
# JWT_SECRET     يوقّع جلسات لوحة الإدارة.
#                تغييره يُخرج كل المستخدمين ويلزمهم تسجيل الدخول من جديد.
JWT_SECRET=

# QR_SIGNING_KEY يوقّع رموز QR الخاصة بالحاويات.
#                ⚠ تغييره يُبطل كل الملصقات المطبوعة ويستوجب إعادة طباعتها كلها.
#                احتفظ بنسخة منه في مكان آمن — لا يمكن استرجاعه.
QR_SIGNING_KEY=

# ─────────── العناوين ───────────
# العنوان العام لواجهة الـAPI كما يراه المتصفح وجوّالات العمال.
# يجب أن يكون HTTPS في الإنتاج.
PUBLIC_BASE_URL=http://localhost:4000

# عنوان لوحة الإدارة (يُستخدم للسماح به في CORS)
ADMIN_ORIGIN=http://localhost:3000

# عناوين إضافية مسموح لها بالاتصال بالـAPI، مفصولة بفواصل. اتركه فارغًا عادةً.
CORS_ORIGINS=

# المنافذ المنشورة على السيرفر
API_PORT=4000
ADMIN_PORT=3000

# ─────────── الخرائط (اختياري) ───────────
# الافتراضي: OpenStreetMap مجانًا وبلا مفتاح.
# لاستخدام نمط خرائط مدفوع ضع رابط style.json هنا.
MAP_STYLE_URL=

# ─────────── ضبط كشف التلاعب ───────────
# أقصى خطأ مقبول في دقة GPS (متر) قبل اعتبار الزيارة مشبوهة
MAX_GPS_ACCURACY_M=100
# أقصى سرعة انتقال منطقية بين مسحين (متر/ثانية) — 45 ≈ 162 كم/س
MAX_PLAUSIBLE_SPEED_MPS=45
# أقصى بُعد مقبول بين موقع المسح ومسار السيارة المسجَّل (متر)
MAX_ROUTE_DEVIATION_M=500

# ─────────── النسخ الاحتياطي ───────────
AUTO_BACKUP_ENABLED=1
AUTO_BACKUP_INTERVAL_HOURS=24

# ─────────── حدود الطلبات ───────────
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
