FROM node:22-alpine
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages ./packages
COPY services/api ./services/api
RUN pnpm install --filter @planet/api...
RUN pnpm --filter @planet/shared-types build && pnpm --filter @planet/config build && pnpm --filter @planet/validation build && pnpm --filter @planet/simulation-models build
EXPOSE 4000
CMD ["pnpm", "--filter", "@planet/api", "dev"]
