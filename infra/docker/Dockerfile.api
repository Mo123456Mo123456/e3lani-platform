FROM node:22-bookworm-slim AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.base.json .npmrc ./
COPY packages ./packages
COPY services ./services
COPY apps ./apps
RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @planet-born/shared-types build \
 && pnpm --filter @planet-born/config build \
 && pnpm --filter @planet-born/validation build \
 && pnpm --filter @planet-born/simulation-models build \
 && pnpm --filter @planet-born/analytics build \
 && pnpm --filter @planet-born/ui build

FROM base AS api
RUN pnpm --filter @planet-born/api build
EXPOSE 4000
CMD ["node", "services/api/dist/index.js"]
