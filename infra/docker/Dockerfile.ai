FROM python:3.12-slim
WORKDIR /app
COPY services/ai-orchestrator /app
RUN pip install --no-cache-dir fastapi uvicorn pydantic || true
RUN printf 'from fastapi import FastAPI\napp=FastAPI()\n@app.get("/health")\ndef h(): return {"ok":True}\n@app.post("/analyze")\ndef a(body:dict):\n  return {"type":body.get("type","event"),"title":body.get("title","x"),"traits":{},"balanceHints":["ok"],"risk":0.2,"structured":body,"provider":"docker-stub"}\n' > /app/main.py
EXPOSE 8002
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8002"]
