FROM node:22-alpine
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml ./
COPY packages ./packages
COPY services/ai-orchestrator ./services/ai-orchestrator
RUN pnpm install --filter @planet/ai-orchestrator...
RUN pnpm --filter @planet/shared-types build && pnpm --filter @planet/validation build && pnpm --filter @planet/simulation-models build
EXPOSE 5001
CMD ["pnpm", "--filter", "@planet/ai-orchestrator", "dev"]
