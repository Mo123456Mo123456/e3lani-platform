FROM python:3.12-slim
WORKDIR /app
COPY services/simulation-engine /app
RUN pip install --no-cache-dir fastapi uvicorn pydantic || true
# Placeholder until sim engine is implemented
RUN printf 'from fastapi import FastAPI\napp=FastAPI()\n@app.get("/health")\ndef h(): return {"ok":True}\n@app.post("/tick")\ndef t(body:dict): return {"tick":body.get("tick",0),"year":0,"events":[],"patches":[],"source":"docker-stub"}\n' > /app/main.py
EXPOSE 8001
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
